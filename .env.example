# ---- Database ----
# Default: local SQLite (zero-config, runs instantly)
DATABASE_URL="file:./dev.db"
# To use Supabase/Postgres instead, set provider="postgresql" in prisma/schema.prisma
# and use a connection string like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ---- Auth ----
JWT_SECRET="change-this-to-a-long-random-secret-string-in-production"

# ---- Email (Nodemailer) ----
# If left blank, emails are logged to the server console (dev fallback) and still stored in the DB.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="3D Education Hub <no-reply@3dedu.hub>"

# ---- App ----
NEXT_PUBLIC_APP_NAME="3D Education Hub"
