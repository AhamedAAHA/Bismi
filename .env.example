# ---- Database (Supabase PostgreSQL) ----
# DATABASE_URL: pooled connection string (port 6543) from Supabase
# DIRECT_URL: direct connection string (port 5432) for migrations / db push

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.unxkjgedidpezqwgpoqi:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.unxkjgedidpezqwgpoqi:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"




# ---- Auth ----
JWT_SECRET="change-this-to-a-long-random-secret-string-in-production"

# ---- Email (Nodemailer) ----
# If left blank, emails are logged to the server console (dev fallback) and still stored in the DB.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="3D Education Hub <no-reply@3dedu.hub>"

# ---- App ----
NEXT_PUBLIC_APP_NAME="3D Education Hub"

# AIML API (https://aimlapi.com)
AIML_API_KEY=""

# Model + TTS tuning (non-secret)
AIML_MODEL_ANALYSIS=gpt-4o-mini
AIML_MODEL_CHAT=gpt-4o
AIML_MODEL_SEARCH=gpt-4o-search-preview
AIML_MODEL_SEARCH_MINI=gpt-4o-mini-search-preview
AIML_SEARCH_CONTEXT_SIZE=medium
AIML_MODEL_INTENT=gpt-4o-mini
AIML_MODEL_WORLD=gpt-4o
AIML_MODEL_VISION=gpt-4o
AIML_MODEL_TRANSCRIBE=whisper-1
AIML_TTS_MODEL=openai/tts-1
AIML_TTS_VOICE=nova
AIML_TTS_SPEED=1.08 
